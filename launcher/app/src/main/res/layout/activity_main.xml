<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden). -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Hero app name hidden as requested (spec 6) -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Dock & Grid RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="68dp"
        android:paddingEnd="68dp"
        android:paddingTop="10dp"
        android:paddingBottom="40dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:descendantFocusability="afterDescendants" />

    <!-- Clock, Date, and Weather Widget on the left, vertically centered -->
    <LinearLayout
        android:id="@+id/leftBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="56dp"
        android:orientation="vertical">

        <!-- Hidden views to preserve compatibility with existing code -->
        <TextView
            android:id="@+id/greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/shamsiDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextClock
            android:id="@+id/ampm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Date: "Thursday, October 22" (locale-aware) -->
        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, MMMM d"
            android:format24Hour="EEEE, MMMM d"
            android:textColor="#CCFFFFFF"
            android:textSize="20sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.01"
            android:includeFontPadding="false" />

        <!-- Clock: Large 24H clock ("15:42") -->
        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFFFF"
            android:textSize="96sp"
            android:fontFamily="@font/outfit_light"
            android:letterSpacing="-0.04"
            android:includeFontPadding="false" />

        <!-- Weather line: "○ 29° Partly Cloudy  H:33° L:21°" -->
        <LinearLayout
            android:id="@+id/weatherRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/weatherIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○"
                android:textColor="#CCFFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit_regular"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/weatherText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="29° Partly Cloudy  H:33° L:21°"
                android:textColor="#CCFFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/outfit_regular"
                android:letterSpacing="0.01"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Prayer schedule line: "☾ Maghrib 17:45 · in 2 h 3 min" -->
        <LinearLayout
            android:id="@+id/prayerRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/prayerIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☾"
                android:textColor="#CCFFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit_regular"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/prayerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maghrib 17:50 · in 8 h 57 min"
                android:textColor="#CCFFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/outfit_regular"
                android:letterSpacing="0.01"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Right 3 Buttons (Inputs, Wifi, Settings) -->
    <LinearLayout
        android:id="@+id/topButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="56dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnInputs"
            style="@style/TopButton"
            android:text="@string/inputs"
            android:drawableStart="@drawable/ic_input"
            android:nextFocusDown="@+id/grid" />

        <TextView
            android:id="@+id/btnWifi"
            style="@style/TopButton"
            android:maxWidth="180dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/wifi"
            android:drawableStart="@drawable/ic_wifi"
            android:nextFocusDown="@+id/grid" />

        <TextView
            android:id="@+id/btnSettings"
            style="@style/TopButton"
            android:text="@string/settings"
            android:drawableStart="@drawable/ic_settings"
            android:nextFocusDown="@+id/grid" />
    </LinearLayout>

    <TextView
        android:id="@+id/dockEditHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/pill_bg"
        android:text="@string/dock_edit_hint"
        android:textColor="#E6FFFFFF"
        android:textSize="13sp"
        android:fontFamily="@font/outfit"
        android:elevation="24dp"
        android:visibility="gone" />

    <!-- Glass highlight view kept hidden as requested (spec 7) -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:visibility="gone"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
